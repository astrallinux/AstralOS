# Sample .ast configuration file
# This demonstrates the PACKAGES syntax with nested blocks, arrays, and states.

PACKAGES {
    firefox = enabled
    ffmpeg {
        state = enabled
        useflags = ["nvenc", "x265"]
    }
    vim {
        state = disabled
        useflags = ["lua", "python3"]
    }
    kernel {
        state = enabled
        version = "6.6"
        modules = ["nvidia", "vboxdrv"]
    }
}

# Another top-level block example
REPOS {
    gentoo = enabled
    local = disabled
    priority = 100
}